# Netlify rewrites for the in-app pages (single-page app). Each legal page works as a direct URL.
# Real files in /public (ads.txt, robots.txt, ad-config.json, /admin/) are served first and are never rewritten.

# Old static URLs from earlier versions of the site
/privacy.html   /privacy-policy        301
/terms.html     /terms-and-conditions  301

# Pages rendered by the app (200 = rewrite, URL stays the same)
/about                  /index.html  200
/privacy-policy         /index.html  200
/terms-and-conditions   /index.html  200
/disclaimer             /index.html  200
/cookie-policy          /index.html  200
/dmca                   /index.html  200
/contact                /index.html  200

# Anything else: serve the app, which renders a "Page not found" screen, with a real 404 status
/*                      /index.html  404
