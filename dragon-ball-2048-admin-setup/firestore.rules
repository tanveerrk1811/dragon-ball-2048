rules_version = '2';

// Dragon Ball 2048 — Firestore Security Rules
//
//   admins/{uid}            owner authorization records. CREATED ONLY BY HAND in the Firebase Console.
//                           A signed-in user may read ONLY their own record; nobody can write it from a client.
//   publicConfig/adConfig   public game configuration (public IDs only — never secrets).
//                           Anyone may read it; only an authenticated, ACTIVE owner may write it.
//   everything else         denied.
//
// Console-created documents and the Admin SDK bypass these rules, which is how the owner record is provisioned.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    // True only for a signed-in user whose UID has an admins/{uid} document that is
    // role == "owner", active == true and whose stored e-mail equals the e-mail on the ID token.
    function isActiveOwner() {
      return signedIn()
        && exists(adminPath())
        && get(adminPath()).data.role == 'owner'
        && get(adminPath()).data.active == true
        && request.auth.token.email != null
        && get(adminPath()).data.email == request.auth.token.email;
    }

    // Shallow schema check for the ad configuration so a bug or a stolen session cannot store arbitrary junk.
    function validAdConfig(c) {
      return c is map
        && c.keys().hasOnly(['version', 'mode', 'masterEnabled', 'web', 'android', 'networks', 'placements', 'androidPlacements', 'analytics'])
        && c.version is int
        && c.mode in ['test', 'production']
        && c.masterEnabled is bool
        && c.web is map
        && c.android is map
        && c.networks is map
        && c.placements is map
        && c.placements.keys().hasOnly(['topBanner', 'bottomBanner', 'gameOver', 'interstitial'])
        && c.androidPlacements is map
        && c.analytics is map;
    }

    // ---- Owner authorization records ----
    match /admins/{uid} {
      // A user can fetch only their own record (needed by the dashboard to verify access). No listing.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      // Never writable from clients — nobody can grant, edit or remove admin rights through the app.
      allow create, update, delete: if false;
    }

    // ---- Public game configuration ----
    match /publicConfig/adConfig {
      allow get: if true;
      allow list: if false;

      allow create: if isActiveOwner()
        && request.resource.data.keys().hasOnly(['config', 'revision', 'updatedAt', 'updatedBy'])
        && validAdConfig(request.resource.data.config)
        && request.resource.data.revision == 1
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow update: if isActiveOwner()
        && request.resource.data.keys().hasOnly(['config', 'revision', 'updatedAt', 'updatedBy'])
        && validAdConfig(request.resource.data.config)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ---- Default: deny everything else ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
